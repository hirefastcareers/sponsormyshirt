# =============================================================================
# Great North Run Kit Sponsorships — Environment Template
# Copy to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Dodo Payments (Merchant of Record) --------------------------------------
DODO_PAYMENTS_API_KEY=your_dodo_api_key
# Webhook signing secret (DODO_WEBHOOK_SECRET is an alias)
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Optional checkout upsells — run `npm run sync:dodo-addons` in live_mode to create
# and auto-write product ids here (£100 social post, £50 dofollow link).
DODO_PRODUCT_SOCIAL_POST=pdt_social_announcement
DODO_PRODUCT_DOFOLLOW_LINK=pdt_dofollow_backlink
# £5 Micro-Sponsor Wall — run `npm run sync:dodo-micro` to create and auto-write.
DODO_PRODUCT_MICRO_SPONSOR=pdt_micro_sponsor

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
