# =============================================================================
# Great North Run Kit Sponsorships — Environment Template
# Copy to `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Dodo Payments (Merchant of Record) --------------------------------------
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Optional checkout upsells — create £100 / £50 one-time products in Dodo,
# then paste their product_ids here so receipts include the add-on line items.
DODO_PRODUCT_SOCIAL_POST=pdt_social_announcement
DODO_PRODUCT_DOFOLLOW_LINK=pdt_dofollow_backlink

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
